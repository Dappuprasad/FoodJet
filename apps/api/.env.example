# ---------------------------------------------------------------- runtime ---
NODE_ENV=development
PORT=3001

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --------------------------------------------------------------- database ---
# Supabase (https://supabase.com) — free tier, no card required.
# Dashboard -> Connect -> "Connection string", then pick the two below.
#
# DATABASE_URL: the TRANSACTION pooler, port 6543. The pgbouncer flag stops
# Prisma emitting prepared statements the pooler cannot handle, and the
# connection limit keeps a single app instance from exhausting the free tier's
# pool.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# DIRECT_DATABASE_URL: the SESSION pooler, port 5432 — same host, different
# port. Migrations need a session-mode connection because the transaction
# pooler cannot run DDL.
#
# Use the session pooler rather than the "direct connection" (db.PROJECT_REF
# .supabase.co): Supabase now serves that host over IPv6 only, which most home
# networks and free-tier hosts cannot reach.
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Any other Postgres works too, e.g. a local install:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodjet?schema=public

# ------------------------------------------------------------------- auth ---
# Both must be at least 32 characters; the API refuses to boot otherwise.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string-000000
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-str
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ------------------------------------------------------------------ demo ----
# Multiplier on the simulated kitchen timings. 1 = realistic (a 25 minute prep
# takes 25 minutes); 40 compresses a full order lifecycle into about a minute.
ORDER_SIMULATION_SPEEDUP=40

# --------------------------------------------------------------- optional ---
SWAGGER_ENABLED=true
THROTTLE_LIMIT=120

# Credentials created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@foodjet.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_EMAIL=demo@foodjet.dev
SEED_CUSTOMER_PASSWORD=Demo@12345