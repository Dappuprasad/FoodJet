# Base URL of the API, including the version prefix.
#
# Leave this UNSET in development: the Vite dev server proxies /api and
# /socket.io to http://localhost:3001, which keeps the app on one origin so the
# httpOnly refresh cookie behaves exactly as it does in production.
#
# In production the API is a separate host, so set the absolute URL:
# VITE_API_URL=https://foodjet-api.onrender.com/api/v1

# Override the dev proxy target if the API runs somewhere other than :3001.
# VITE_DEV_API_TARGET=http://localhost:3001
